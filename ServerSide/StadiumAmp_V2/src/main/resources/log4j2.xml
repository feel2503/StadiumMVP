<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="debug" monitorInterval="5">
    <!-- 공통 속성 설정 -->
    <Properties>
        <Property name="logFileName">log4jFile</Property>
        <Property name="basePath">logs</Property>
        <Property name="consoleLayout">[%d{yyyy-MM-dd HH:mm:ss}] [%-5p] [%c{1}:%L] - %m%n</Property>
        <Property name="fileLayout">%d [%t] %-5level %c(%M:%L) - %m%n</Property>
    </Properties>

    <!-- Log Appender 설정 -->
    <Appenders>
        <!-- 1. 콘솔 출력 설정 -->
        <Console name="console" target="SYSTEM_OUT">
            <PatternLayout pattern="${consoleLayout}" />
        </Console>

        <!-- 2. 통합 로그 파일 설정 (하루에 1번 생성, 최대 10일 보관) -->
        <RollingFile name="file"
                     fileName="${basePath}/${logFileName}.log"
                     filePattern="${basePath}/${logFileName}.%d{yyyy-MM-dd}.log">
            <PatternLayout pattern="${fileLayout}" />
            <Policies>
                <!-- 매일 자정에 기존 로그를 백업하고 새 로그 파일 생성 -->
                <TimeBasedTriggeringPolicy modulate="true" interval="1" />
            </Policies>
            <DefaultRolloverStrategy>
                <!-- 10일이 지난 오래된 로그 파일은 자동으로 삭제 처리 -->
                <Delete basePath="${basePath}" maxDepth="3">
                    <IfLastModified age="10d" />
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>
    </Appenders>

    <!-- TRACE > DEBUG > INFO > WARN > ERROR > FATAL -->
    <Loggers>
        <!-- 스프링 프레임워크 로그 (INFO 이상 콘솔/파일 기록) -->
        <Logger name="org.springframework" level="info" additivity="false">
            <AppenderRef ref="console" />
            <AppenderRef ref="file" />
        </Logger>

        <!-- 비즈니스 로직 로그 (INFO, WARN, ERROR 모두 콘솔/파일에 함께 기록) -->
        <Logger name="com.thiscat.stadiumamp" level="info" additivity="false">
            <AppenderRef ref="file" />
            <AppenderRef ref="console"/>
        </Logger>

        <!-- 루트 로거 (기본값: WARN 이상만 콘솔 출력) -->
        <Root level="warn">
            <AppenderRef ref="console"/>
        </Root>
    </Loggers>
</Configuration>